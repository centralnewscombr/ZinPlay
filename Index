create or replace function public.zinplay_increment_views(video_id uuid)
returns void
language sql
security definer
set search_path=public
as $$
  update public.zinplay_videos
  set views_count=views_count+1
  where id=video_id and status='published';
$$;

grant execute on function public.zinplay_increment_views(uuid)
to anon,authenticated;

-- Armazenamento dos vídeos e capas

insert into storage.buckets(
  id,
  name,
  public,
  file_size_limit,
  allowed_mime_types
)
values(
  'zinplay-media',
  'zinplay-media',
  true,
  524288000,
  array[
    'video/mp4',
    'video/webm',
    'video/quicktime',
    'video/x-m4v',
    'image/jpeg',
    'image/png',
    'image/webp'
  ]
)
on conflict(id) do update set
  public=true,
  file_size_limit=524288000,
  allowed_mime_types=excluded.allowed_mime_types;

drop policy if exists "zinplay media public read"
on storage.objects;

create policy "zinplay media public read"
on storage.objects
for select
using(bucket_id='zinplay-media');

drop policy if exists "zinplay media upload own"
on storage.objects;

create policy "zinplay media upload own"
on storage.objects
for insert to authenticated
with check(
  bucket_id='zinplay-media'
  and (storage.foldername(name))[1]=auth.uid()::text
);

drop policy if exists "zinplay media update own"
on storage.objects;

create policy "zinplay media update own"
on storage.objects
for update to authenticated
using(
  bucket_id='zinplay-media'
  and (
    (storage.foldername(name))[1]=auth.uid()::text
    or public.zinplay_is_admin()
  )
)
with check(
  bucket_id='zinplay-media'
  and (
    (storage.foldername(name))[1]=auth.uid()::text
    or public.zinplay_is_admin()
  )
);

drop policy if exists "zinplay media delete own"
on storage.objects;

create policy "zinplay media delete own"
on storage.objects
for delete to authenticated
using(
  bucket_id='zinplay-media'
  and (
    (storage.foldername(name))[1]=auth.uid()::text
    or public.zinplay_is_admin()
  )
);
